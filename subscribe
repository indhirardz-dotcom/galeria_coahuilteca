<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex,follow">
  <title>Join the Gallery List | Galería Coahuilteca</title>
  <meta name="description" content="Choose email or WhatsApp to receive exhibition invitations and news from Galería Coahuilteca in San Miguel de Allende.">

  <style>
    *{box-sizing:border-box}

    body{
      min-height:100vh;
      margin:0;
      display:grid;
      place-items:center;
      padding:28px;
      background:#f7f4ef;
      color:#111;
      font-family:Helvetica,Arial,sans-serif;
    }

    main{
      width:min(560px,100%);
      text-align:center;
    }

    .logo{
      width:auto;
      height:43px;
      margin-bottom:62px;
    }

    .kicker{
      margin:0 0 20px;
      color:#8a6b27;
      font-size:12px;
      letter-spacing:.2em;
      text-transform:uppercase;
    }

    h1{
      margin:0;
      font-family:Georgia,serif;
      font-size:58px;
      line-height:1;
      font-weight:400;
    }

    .intro{
      max-width:430px;
      margin:24px auto 38px;
      color:#555;
      font-size:18px;
      line-height:1.55;
    }

    form{
      display:flex;
      gap:10px;
      width:100%;
    }

    input[type="email"]{
      min-width:0;
      flex:1;
      padding:17px;
      border:1px solid #999;
      border-radius:0;
      background:white;
      color:#111;
      font:inherit;
      font-size:16px;
    }

    button,.whatsapp{
      padding:17px 25px;
      border:1px solid #111;
      border-radius:0;
      background:#111;
      color:white;
      cursor:pointer;
      font-size:12px;
      letter-spacing:.12em;
      text-decoration:none;
      text-transform:uppercase;
    }

    .divider{
      display:flex;
      align-items:center;
      gap:15px;
      margin:30px 0;
      color:#888;
      font-size:12px;
      letter-spacing:.15em;
      text-transform:uppercase;
    }

    .divider::before,.divider::after{
      content:"";
      flex:1;
      height:1px;
      background:#ccc;
    }

    .whatsapp{
      display:block;
      width:100%;
      background:transparent;
      color:#111;
    }

    .privacy{
      margin-top:24px;
      color:#777;
      font-size:12px;
      line-height:1.5;
    }

    .back{
      display:inline-block;
      margin-top:44px;
      color:#555;
      font-size:13px;
      text-decoration:none;
    }

    @media(max-width:600px){
      body{padding:24px}
      .logo{height:36px;margin-bottom:46px}
      h1{font-size:44px}
      form{flex-direction:column}
      button{width:100%}
    }
  </style>
</head>

<body>
  <main>
    <a href="index.html">
      <img class="logo" src="logo.png" alt="Galería Coahuilteca">
    </a>

    <p class="kicker">Private gallery list</p>
    <h1>Stay close<br>to the art</h1>
    <p class="intro">Receive exhibition invitations and important news from Galería Coahuilteca.</p>

    <form action="https://formsubmit.co/hello@galeriacoahuilteca.com" method="POST">
      <label for="email" style="position:absolute;left:-9999px;">Email address</label>
      <input id="email" name="email" type="email" placeholder="Your email address" autocomplete="email" required>
      <input type="hidden" name="_subject" value="New Galería Coahuilteca newsletter subscription">
      <input type="hidden" name="_template" value="table">
      <input type="hidden" name="_captcha" value="false">
      <input type="hidden" name="_next" value="https://galeriacoahuilteca.com/?subscribed=1">
      <button type="submit">Subscribe</button>
    </form>

    <div class="divider">or</div>

    <a class="whatsapp" href="https://wa.me/524152169737?text=Hi%2C%20I%20would%20like%20to%20receive%20exhibition%20invitations%20and%20news%20from%20Galer%C3%ADa%20Coahuilteca%20by%20WhatsApp." target="_blank" rel="noopener">
      Continue with WhatsApp
    </a>

    <p class="privacy">Choose one option. Occasional messages only. You can unsubscribe at any time.</p>

    <a class="back" href="index.html">Visit the gallery website →</a>
  </main>
</body>
</html>
